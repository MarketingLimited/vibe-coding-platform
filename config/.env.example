# -----------------------------------------------------------------------------
# Vibe Coding Platform - Environment Example
# Copy this file to `.env` and `config/.env`, then adjust the values as needed.
# The interactive setup script at `tools/setup/activate.sh` can automate this.
# -----------------------------------------------------------------------------

# Core API settings
API_HOST=0.0.0.0
API_PORT=9000
DOMAIN=localhost
# عنوان الـ API العام (يجب أن يبدأ بـ https://)
API_PUBLIC_BASE_URL=https://api.example.com
API_KEY=change-me
MASTER_API_KEY=
ADMIN_ALERT_EMAIL=alerts@example.com

# CORS Security - قائمة النطاقات المسموح بها (مفصولة بفواصل)
# Leave empty to disable CORS completely (recommended for API-only access)
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# File system locations
DATA_DIR=/srv/vibe
PROJECTS_DIR=/projects
LOGS_DIR=/logs

# Database configuration
DB_TYPE=sqlite
DB_PATH=/data/projects.db
DB_PASSWORD=

# GitHub encrypted secrets storage
GITHUB_SECRETS_PATH=/data/github-secrets.bin
GITHUB_SECRETS_KEY=

# Redis cache configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Rate limits and quotas
MAX_PROJECTS_PER_USER=10
PROJECT_CPU_LIMIT=2.0
PROJECT_MEMORY_LIMIT=4G
PROJECT_STORAGE_LIMIT=10G

EXEC_TIMEOUT=300
MAX_OUTPUT_SIZE=10485760

ENABLE_RATE_LIMIT=true
# تحديد وضع الفشل عند عدم توفر Redis (fail closed vs fail open)
# true = رفض الطلبات عند فشل Redis (أكثر أمانًا)
# false = السماح بالطلبات عند فشل Redis (أقل أمانًا لكن أكثر توفرًا)
STRICT_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60
EXEC_RATE_LIMIT_PER_MINUTE=60
PROJECT_CREATE_RATE_LIMIT=5
PROJECT_INFO_RATE_LIMIT=30
PASSWORD_ROTATE_RATE_LIMIT=4
PROJECT_DELETE_RATE_LIMIT=4

# Internal services
PROJECT_MANAGER_HOST=project-manager
PROJECT_MANAGER_PORT=9400
PROJECT_MANAGER_SCHEME=http
HEALTH_POLL_INTERVAL=30

# Cleanup service
CLEANUP_INTERVAL=86400
